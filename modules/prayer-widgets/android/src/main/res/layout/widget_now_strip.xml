<?xml version="1.0" encoding="utf-8"?>
<!--
  Now widget, STRIP face — 4×1, one row (D182; redesigned by D185). The 2×2's hero, laid out wide
  and set big: nothing on the paper but the key facts and the button (owner, 2026-10-10: "big in
  your face, key info there, and the button to mark the prayer as done or undone, like the other
  widgets").

  - Leading, two lines: the mark, the prayer's name and its Arabic companion; under them the live
    Chronometer at 36sp (or the static @+id/big line for the states that are not a countdown)
    with the one-word deadline caption riding its baseline.
  - Trailing: the buddies who prayed this one (D177 widened by D182) and the current prayer's
    seal, 54dp, as the "I prayed" button. Between the two, the other widgets' ornament rule stood
    upright (D186): hairline, ◆, hairline — the one decoration, so the face still reads as a
    sibling of the 2×2. When nothing is markable (the sunrise gap, an exempt
    day) the seal gives its place to the day's five seals, as on the 2×2.

  textStyle doubles every @font weight: the launcher inflates widgets under a restricted Context,
  where TextView ignores resource fonts, so on a device these lines are the system face and only
  textStyle carries the hierarchy.

  The caption yields first when width runs out, then the name shrinks. Same view ids as
  widget_now.xml, so WidgetRenderer.buildNow binds both faces. forceDarkAllowed pins the
  runtime-tinted palette against OEM force-dark repainting. The Arabic variant
  (widget_now_strip_arabic.xml) is DERIVED — regenerate with `bun scripts/derive-arabic-layouts.ts`.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/root"
  android:layoutDirection="ltr"
  android:forceDarkAllowed="false"
  tools:targetApi="q"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:importantForAccessibility="no"
    android:src="@drawable/paper_shape" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
          android:id="@+id/mark"
          android:layout_width="27dp"
          android:layout_height="17dp"
          android:layout_marginEnd="8dp"
          android:importantForAccessibility="no"
          android:src="@drawable/glyph_mosque" />
        <TextView
          android:id="@+id/name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxWidth="120dp"
          android:fontFamily="@font/lora_600semibold"
          android:textStyle="bold"
          android:textSize="20dp"
          android:autoSizeTextType="uniform"
          android:autoSizeMinTextSize="15dp"
          android:autoSizeMaxTextSize="20dp"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/arabic"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:fontFamily="@font/amiri_400regular"
          android:textSize="18dp"
          android:includeFontPadding="false"
          android:visibility="gone"
          android:maxLines="1" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:baselineAligned="true">
        <ImageView
          android:id="@+id/big_glyph"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:layout_gravity="center_vertical"
          android:visibility="gone"
          android:importantForAccessibility="no" />
        <Chronometer
          android:id="@+id/countdown"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:countDown="true"
          android:fontFamily="@font/lora_700bold"
          android:fontFeatureSettings="tnum"
          android:textStyle="bold"
          android:textSize="36dp"
          android:includeFontPadding="false"
          android:visibility="gone"
          android:maxLines="1" />
        <!-- The calm countdown (D198): H:MM, no seconds, redrawn each minute by TransitionAlarms. -->
        <TextView
          android:id="@+id/calm"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/lora_700bold"
          android:fontFeatureSettings="tnum"
          android:textStyle="bold"
          android:textSize="36dp"
          android:includeFontPadding="false"
          android:visibility="gone"
          android:maxLines="1" />
        <TextView
          android:id="@+id/big"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxWidth="170dp"
          android:fontFamily="@font/lora_600semibold"
          android:textStyle="bold"
          android:textSize="28dp"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
        <TextView
          android:id="@+id/cap"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="10dp"
          android:fontFamily="@font/lora_400regular_italic"
          android:textStyle="italic"
          android:textSize="16sp"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>

    <!-- The manuscript ornament rule of the other widgets, stood upright: hairline, ◆, hairline,
         between what the prayer is and the button that marks it (D186). -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="match_parent"
      android:layout_marginStart="12dp"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="4dp"
      android:orientation="vertical"
      android:gravity="center_horizontal">
      <ImageView
        android:id="@+id/orn1_l"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/card_shape" />
      <ImageView
        android:id="@+id/orn1"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:importantForAccessibility="no"
        android:src="@drawable/glyph_diamond" />
      <ImageView
        android:id="@+id/orn1_r"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:src="@drawable/card_shape" />
    </LinearLayout>

    <!-- Buddy badges (D182): the same bitmap the large widget's rows carry. GONE unless
         somebody has buddies and one of them prayed the current prayer. -->
    <ImageView
      android:id="@+id/buddies"
      android:layout_width="wrap_content"
      android:layout_height="24dp"
      android:layout_marginStart="10dp"
      android:adjustViewBounds="true"
      android:visibility="gone"
      android:importantForAccessibility="no" />
    <FrameLayout
      android:id="@+id/now_seal"
      android:layout_width="54dp"
      android:layout_height="54dp"
      android:layout_marginStart="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/now_seal_fill"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:importantForAccessibility="no" />
      <ImageView
        android:id="@+id/now_seal_glyph"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- The day's five seals, in the seal's place when there is nothing to mark. -->
    <LinearLayout
      android:id="@+id/dots"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:orientation="horizontal"
      android:visibility="gone">
        <FrameLayout
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginEnd="7dp">
          <ImageView
            android:id="@+id/d1_fill"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/d1_glyph"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginEnd="7dp">
          <ImageView
            android:id="@+id/d2_fill"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/d2_glyph"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginEnd="7dp">
          <ImageView
            android:id="@+id/d3_fill"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/d3_glyph"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginEnd="7dp">
          <ImageView
            android:id="@+id/d4_fill"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/d4_glyph"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
          android:layout_width="18dp"
          android:layout_height="18dp">
          <ImageView
            android:id="@+id/d5_fill"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />
          <ImageView
            android:id="@+id/d5_glyph"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
