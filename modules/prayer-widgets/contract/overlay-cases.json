{
  "description": "The widget overlay contract (D26): given a day's base statuses and the raw pending-marks queue, every implementation — TypeScript (domain/pendingMarks), Kotlin (prayer-widgets), Swift (targets/widget) — must produce these exact effective statuses. The rule is the drain's rule: a prayed entry shows only over unlogged, a clears/undo only over prayed; latest decidedAt wins per (day, prayer); entries for other days and entries that cannot be read are ignored. src/domain/pendingMarksContract.test.ts holds TypeScript to this file; the native sides are held to it by review against the same cases.",
  "version": 1,
  "cases": [
    {
      "name": "widget tap marks the current unlogged prayer",
      "day": "2026-08-25",
      "statuses": { "fajr": "prayed", "dhuhr": "unlogged", "asr": "unlogged", "maghrib": "unlogged", "isha": "unlogged" },
      "entries": [{ "id": "t1", "day": "2026-08-25", "prayer": "asr", "decidedAt": 1000 }],
      "effective": { "fajr": "prayed", "dhuhr": "unlogged", "asr": "prayed", "maghrib": "unlogged", "isha": "unlogged" }
    },
    {
      "name": "tap twice: prayed then clears collapses to no visible change",
      "day": "2026-08-25",
      "statuses": { "fajr": "unlogged", "dhuhr": "unlogged", "asr": "unlogged", "maghrib": "unlogged", "isha": "unlogged" },
      "entries": [
        { "id": "t1", "day": "2026-08-25", "prayer": "asr", "decidedAt": 1000 },
        { "id": "t2", "day": "2026-08-25", "prayer": "asr", "decidedAt": 2000, "clears": true }
      ],
      "effective": { "fajr": "unlogged", "dhuhr": "unlogged", "asr": "unlogged", "maghrib": "unlogged", "isha": "unlogged" }
    },
