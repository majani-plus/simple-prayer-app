  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "typecheck:swift": "bash scripts/typecheck-swift.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "version:bump": "bun scripts/bump-version.ts",
    "pre-release": "bun run lint && bun run typecheck && bun run typecheck:swift && bun run test",
    "release": "bun pre-release && eas build --platform all --auto-submit --non-interactive && eas build --profile production-wear --platform android --auto-submit --non-interactive && eas build --profile production-wear-face --platform android --auto-submit --non-interactive",
    "release:wear": "eas build --profile production-wear --platform android --auto-submit --non-interactive",
    "release:wear-face": "eas build --profile production-wear-face --platform android --auto-submit --non-interactive",
    "release:android": "bun pre-release && eas build --platform android --auto-submit --non-interactive",
    "release:ios": "bun pre-release && eas build --platform ios --auto-submit --non-interactive"
  },
  "license": "MIT",
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "better-sqlite3",
    "esbuild",
    "unrs-resolver"
  ],
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/db/__tests__/testDb.ts",
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|native-base|react-native-svg|immer|zustand|@formatjs/.*)"
    ],
    "setupFilesAfterEnv": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/jest.setup.js"
    ]
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-notifications"
      ],
      "android": {
        "exclude": [
          "foss-location"
        ]
      }
    }
  },
  "patchedDependencies": {
    "adhan@4.4.6": "patches/adhan@4.4.6.patch",
