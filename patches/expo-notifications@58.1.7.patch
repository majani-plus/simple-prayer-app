+++ b/android/src/main/java/expo/modules/notifications/notifications/presentation/builders/ExpoNotificationBuilder.kt
@@ -97,6 +97,22 @@ open class ExpoNotificationBuilder(
 
     val content = notificationContent
 
+    // simple-prayer patch (D146): pass Notification.category through from the request payload.
+    // Deliberately dumb -- which category applies is decided in src/services/notifications.ts.
+    content.body?.optString("androidCategory")?.takeIf { it.isNotEmpty() }
+      ?.let { builder.setCategory(it) }
+
+    // simple-prayer patch (D165): honour the payload's own expiry. Every reminder the app
+    // schedules carries `expiresAt` (epoch ms) — the instant its row stops being true: a
+    // prayer's window end, or the next prayer's start for the sunrise note. The system enforces
+    // `setTimeoutAfter` itself, with no alarm, no permission and no app process, and it survives a
+    // reboot because it is a property of the posted row. The remaining duration is computed at
+    // post time so a late delivery still expires at the right instant, never later.
+    content.body?.optLong("expiresAt", 0L)?.takeIf { it > 0L }?.let { expiresAt ->
+      val remaining = expiresAt - System.currentTimeMillis()
+      if (remaining > 0L) builder.setTimeoutAfter(remaining)
+    }
+
     builder.setAutoCancel(content.isAutoDismiss)
     builder.setOngoing(content.isSticky)
 
