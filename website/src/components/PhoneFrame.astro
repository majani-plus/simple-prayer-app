---
/**
 * A quiet device frame around a real screenshot. The bezel is drawn in ink so it works on both
 * papers; no vendor hardware is imitated.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <slot />
</div>

<style>
  /* The same warm-dark case and gold hairline the composed store screens draw — one framing
     language on the site and in the listings. The case is hardware, so it never themes. */
  .phone {
    border-radius: clamp(26px, 12%, 44px);
    background: #0f0c08;
    padding: 4px;
    outline: 1px solid var(--border-strong);
    overflow: hidden;
    box-shadow: 0 18px 50px -22px var(--shadow-gold);
    line-height: 0;
  }
  .phone :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: clamp(22px, 10.5%, 40px);
  }
</style>
