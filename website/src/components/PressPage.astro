---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from './Logo.astro';
import { site } from '../config';
import { pagePath, type Locale } from '../i18n';
import { pressContact, pressCopy, pressFiles } from '../press';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = pressCopy[locale];

// This language's store screens, shown small here; the full-size files are in the zips
// (scripts/build-press-kit.ts). The glob is static (Vite needs a literal) and filtered per locale.
const all = import.meta.glob<{ default: ImageMetadata }>('../../../docs/store-screens/*/0[1-7]-*.png', {
  eager: true,
});
const shots = await Promise.all(
  Object.entries(all)
    .filter(([path]) => path.includes(`/store-screens/${locale}/`) && !path.includes('-play'))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => ({
      name: path.split('/').pop()!.replace('.png', '').replace(/^\d+-/, ''),
      img: await getImage({ src: mod.default, width: 300, format: 'webp' }),
    })),
);
const [qPre, qPost] = c.questions.split('{email}');
const path = pagePath('press', locale);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: c.title,
    inLanguage: locale,
    url: new URL(path, Astro.site).href,
    about: { '@type': 'MobileApplication', name: site.name, url: new URL('/', Astro.site).href },
    publisher: { '@id': 'https://majani.plus/#organization' },
  },
];
---

<Base title={c.title} description={c.description} path={path} locale={locale} page="press" jsonLd={jsonLd}>
  <div class="section container press">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <p class="downloads">
      <a class="btn" href={pressFiles.all(locale)} download>{c.downloadAll}</a>
      <a class="btn btn-quiet" href={pressFiles.factSheet(locale)} download>{c.factSheet}</a>
    </p>
    <p class="hint">{qPre}<a href={`mailto:${pressContact}`} dir="ltr">{pressContact}</a>{qPost}</p>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>{c.describeH2}</h2>
    <p class="caption">{c.describeCaption}</p>
    <div class="card copy">
      <p class="label">{c.oneLineLabel}</p>
      <p>{c.oneLine}</p>
    </div>
    <div class="card copy">
      <p class="label">{c.shortLabel}</p>
      <p>{c.short}</p>
    </div>
    <div class="card copy">
      <p class="label">{c.longLabel}</p>
      {c.long.map((para) => <p>{para}</p>)}
    </div>

    <h2>{c.factsH2}</h2>
    <dl class="facts">
      {c.facts.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))}
    </dl>

    <h2>{c.highlightsH2}</h2>
    <ul class="highlights">
      {c.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <p>
      {c.articles[0]}<a href="/blog" hreflang={locale === 'en' ? undefined : 'en'}>{c.articles[1]}</a>{c.articles[2]}
    </p>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>{c.screenshotsH2}</h2>
    <p>{c.screenshotsText}</p>
    <p class="downloads">
      {pressFiles.screenshots.map((s) => (
        <a class="btn btn-quiet" href={s.href} download lang={s.lang}>{s.label}</a>
      ))}
    </p>
    <ul class="shots">
      {shots.map((s) => (
        <li>
          <img src={s.img.src} width={s.img.attributes.width} height={s.img.attributes.height} alt={c.shotAlt[s.name] ?? ''} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>

    <h2>{c.logoH2}</h2>
    <div class="logo-row" dir="ltr">
      <div class="logo-tile logo-paper"><Logo size={64} /></div>
      <div class="logo-tile logo-gold"><Logo size={64} color="#f3e7c8" /></div>
      <div class="logo-tile logo-night"><Logo size={64} color="#f3e7c8" /></div>
    </div>
    <p class="downloads">
      <a class="btn btn-quiet" href={pressFiles.logos} download>{c.logosLabel}</a>
      <a class="btn btn-quiet" href={pressFiles.icon} download>{c.iconLabel}</a>
    </p>
    <ul>
      {c.logoRules.map((r) => <li>{r}</li>)}
      <li>
        {c.trademarkRule[0]}<a href={`${site.sourceUrl}/blob/main/TRADEMARKS.md`} rel="noopener" hreflang={locale === 'en' ? undefined : 'en'}>{c.trademarkRule[1]}</a>{c.trademarkRule[2]}
      </li>
    </ul>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>{c.wrongH2}</h2>
    <dl class="facts accuracy">
      {c.accuracy.map(([wrong, right]) => (
        <>
          <dt>{c.wrongFormat.replace('{x}', wrong)}</dt>
          <dd>{right}</dd>
        </>
      ))}
    </dl>

    <h2>{c.linksH2}</h2>
    <dl class="facts">
      {c.links.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd><a href={v} rel="noopener" dir="ltr">{v.replace(/^https:\/\//, '')}</a></dd>
        </>
      ))}
    </dl>
  </div>
</Base>

<style>
  .press {
    max-width: 820px;
  }
  .lead {
    font-size: 1.12rem;
  }
  h2 {
    margin-top: 2.2rem;
  }
  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 1.2rem 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px; /* the app's touch floor (D55) */
    padding: 10px 20px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    color: var(--seal-fg);
    background: var(--accent);
    border: 1px solid var(--accent);
  }
  .btn:hover {
    color: var(--seal-fg);
    background: var(--accent-deep);
  }
  .btn-quiet {
    color: var(--ink);
    background: var(--card);
    border-color: var(--border-mid);
    font-weight: 400;
  }
  .btn-quiet:hover {
    color: var(--ink);
    background: var(--card-bright);
    border-color: var(--border-strong);
  }
  .copy {
    margin-bottom: 12px;
  }
  .copy p:last-child {
    margin-bottom: 0;
  }
  .label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--diamond);
    margin-bottom: 0.4em;
  }
  .facts {
    display: grid;
    grid-template-columns: minmax(150px, 220px) 1fr;
    gap: 0;
    margin: 0;
  }
  .facts dt,
  .facts dd {
    margin: 0;
    padding: 10px 0;
    border-top: 1px solid var(--hairline);
  }
  .facts dt {
    font-weight: 600;
    padding-inline-end: 16px;
  }
  .facts dd a {
    overflow-wrap: anywhere;
  }
  .accuracy dt {
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
  }
  :global(html[lang='ar']) .accuracy dt {
    font-style: normal; /* Arabic has no italic; weight carries the quieter tier (as in global.css) */
    font-weight: 500;
  }
  .highlights li {
    margin-bottom: 0.4em;
  }
  .shots {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .shots img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid var(--border-faint);
  }
  .logo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 1rem 0 0.4rem;
  }
  .logo-tile {
    width: 140px;
    height: 110px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    border: 1px solid var(--border-faint);
  }
  .logo-paper {
    background: var(--card);
  }
  .logo-gold {
    background: #8a6420;
  }
  .logo-night {
    background: #20190e;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
