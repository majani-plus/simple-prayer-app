---
/**
 * A seal-styled icon chip for the compact feature cards: the app's 48px seal circle
 * (docs/DESIGN.md) around a small inline glyph drawn in the same rounded style as the app's
 * Material Symbols Rounded vocabulary. Inline SVG needs no font and no request, so it is
 * CSP-clean, and it inherits `currentColor` (the gold accent token in both themes).
 *
 * Decorative only — the card's title carries the meaning (icon + word rule), so the chip is
 * hidden from assistive tech.
 */
interface Props {
  name:
    | 'mosque'
    | 'bell'
    | 'calendar'
    | 'export'
    | 'grid'
    | 'lock'
    | 'countdown'
    | 'watch'
    | 'tablet';
}
const { name } = Astro.props;
---

<span class="seal-chip" aria-hidden="true">
  {name === 'mosque' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 19.25 H21" />
      <path d="M6.75 19.25 V12.5 H17.25 V19.25" />
      <path d="M8.25 12.5 C8.25 9.6 10.3 8.4 12 7 C13.7 8.4 15.75 9.6 15.75 12.5" />
      <path d="M12 7 V4.9" />
      <path d="M10.6 19.25 V16.4 A1.4 1.4 0 0 1 13.4 16.4 V19.25" />
      <path d="M4.9 19.25 V10 M4.15 10 H5.65 M4.9 10 V8.2" />
      <path d="M19.1 19.25 V10 M18.35 10 H19.85 M19.1 10 V8.2" />
    </svg>
  )}
  {name === 'bell' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4.2 C8.8 4.2 6.8 6.6 6.8 9.6 V13.2 L5.2 15.8 H18.8 L17.2 13.2 V9.6 C17.2 6.6 15.2 4.2 12 4.2 Z" />
      <path d="M10.3 18.6 A1.8 1.8 0 0 0 13.7 18.6" />
      <path d="M3.4 7.8 C3.7 5.9 4.7 4.5 6.1 3.5" />
      <path d="M20.6 7.8 C20.3 5.9 19.3 4.5 17.9 3.5" />
    </svg>
  )}
  {name === 'calendar' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="5.5" width="16" height="15" rx="2.5" />
      <path d="M8.5 3.4 V7 M15.5 3.4 V7 M4 10.2 H20" />
      <circle cx="8.4" cy="14.2" r="1" fill="currentColor" stroke="none" />
      <circle cx="12" cy="14.2" r="1" fill="currentColor" stroke="none" />
      <circle cx="15.6" cy="14.2" r="1" fill="currentColor" stroke="none" />
    </svg>
  )}
  {name === 'export' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 13.5 V17.5 A2 2 0 0 0 7 19.5 H17 A2 2 0 0 0 19 17.5 V13.5" />
      <path d="M12 14.5 V4.5" />
      <path d="M8.5 8 L12 4.5 L15.5 8" />
    </svg>
  )}
  {name === 'grid' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="4" width="7" height="7" rx="2" />
      <rect x="13" y="4" width="7" height="7" rx="2" />
      <rect x="4" y="13" width="7" height="7" rx="2" />
      <rect x="13" y="13" width="7" height="7" rx="2" />
    </svg>
  )}
  {name === 'lock' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5.5" y="10.5" width="13" height="9.5" rx="2.4" />
      <path d="M8.5 10.5 V8 A3.5 3.5 0 0 1 15.5 8 V10.5" />
      <circle cx="12" cy="15.2" r="1" fill="currentColor" stroke="none" />
    </svg>
  )}
  {name === 'countdown' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="13" r="7.2" />
      <path d="M12 9.4 V13 L14.6 14.8" />
      <path d="M10 3.6 H14" />
      <path d="M12 3.6 V5.8" />
    </svg>
  )}
  {name === 'watch' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6.5" y="6.5" width="11" height="11" rx="3.2" />
      <path d="M9 6.5 L9.6 3.2 H14.4 L15 6.5" />
      <path d="M9 17.5 L9.6 20.8 H14.4 L15 17.5" />
      <path d="M12 10 V12.4 L13.7 13.6" />
    </svg>
  )}
  {name === 'tablet' && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4.5" y="3.5" width="15" height="17" rx="2.4" />
      <path d="M12 5.8 V18.2" />
    </svg>
  )}
</span>

<style>
  .seal-chip {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--card-elevated);
    border: 1px solid var(--border-strong);
    box-shadow: 0 2px 8px -2px var(--shadow-gold);
    color: var(--accent);
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
  }
  .seal-chip svg {
    display: block;
  }
</style>
