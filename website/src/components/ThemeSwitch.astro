---
/**
 * Three-state theme control: System (default) / Light / Dark — icon-only, so each button carries
 * an explicit accessible name (aria-label + title); the group is named too. Glyphs are inline
 * SVG drawn in the same stroked vocabulary as the mosque mark and the seal icons.
 *
 * How the states work: an explicit choice stamps `data-theme` on <html> and is persisted in
 * localStorage; "System" removes both, handing control back to the CSS `prefers-color-scheme`
 * media query — following the OS live costs no JS. A static blocking inline script in
 * Base.astro's <head> re-applies the stored choice before first paint (no flash); this component
 * only renders the control and keeps it in sync.
 *
 * CSP note: this <script> is bundled by Astro into an external module covered by
 * `script-src 'self'` — nothing here may build script text at runtime.
 */
interface Props {
  /** Accessible name for the group, localized by the caller. */
  groupLabel: string;
  /** Accessible names for the three buttons, localized by the caller. */
  labels: { system: string; light: string; dark: string };
}
const { groupLabel, labels } = Astro.props;

const icons = {
  // Half-filled circle: "follow the system", half light / half dark.
  system:
    '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 4.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"/></svg>',
  // Sun.
  light:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/></svg>',
  // Crescent moon.
  dark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.6A8 8 0 1 1 10.4 4a6.4 6.4 0 0 0 9.6 9.6z"/></svg>',
};

const buttons = [
  { key: 'system', pressed: 'true' },
  { key: 'light', pressed: 'false' },
  { key: 'dark', pressed: 'false' },
] as const;
---

<div class="theme-switch" role="group" aria-label={groupLabel} data-theme-switch>
  {/* The highlight. Positioned by CSS from html[data-theme] — which the pre-paint head script
      in Base.astro already stamps — so it starts on the right option with no flash and no JS,
      and glides when the choice changes. */}
  <span class="indicator" aria-hidden="true"></span>
  {
    buttons.map(({ key, pressed }) => (
      <button
        type="button"
        data-set-theme={key}
        aria-pressed={pressed}
        aria-label={labels[key]}
        title={labels[key]}
      >
        <span class="glyph" set:html={icons[key]} />
      </button>
    ))
  }
</div>

<style>
  .theme-switch {
    position: relative;
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: 1px solid var(--border-mid);
    border-radius: 999px;
    background: var(--card);
  }
  /* The gliding highlight. Offsets are geometry the buttons already fix (2px padding + 34px
     button + 2px gap); logical `inset-inline-start` keeps the travel correct under RTL.
     Both transitions are disabled globally under prefers-reduced-motion (global.css). */
  .indicator {
    position: absolute;
    top: 2px;
    inset-inline-start: 2px;
    width: 34px;
    height: 28px;
    border-radius: 999px;
    background: var(--accent);
    transition: inset-inline-start 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(html[data-theme='light']) .indicator {
    inset-inline-start: 38px;
  }
  :global(html[data-theme='dark']) .indicator {
    inset-inline-start: 74px;
  }
  .theme-switch button {
    /* Positioned so the glyph paints above the absolutely-positioned indicator. */
    position: relative;
    border: 0;
    background: none;
    color: var(--header);
    width: 34px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    cursor: pointer;
    padding: 0;
    /* The glyph cross-fades between its resting and highlighted colours as the pill arrives. */
    transition: color 200ms;
  }
  .theme-switch button:hover[aria-pressed='false'] {
    color: var(--accent);
  }
  /* The active glyph is keyed off html[data-theme] like the indicator — correct on first paint,
     before this component's script has synced aria-pressed. */
  :global(html:not([data-theme])) button[data-set-theme='system'],
  :global(html[data-theme='light']) button[data-set-theme='light'],
  :global(html[data-theme='dark']) button[data-set-theme='dark'] {
    color: var(--seal-fg);
  }
  .glyph {
    display: inline-flex;
    width: 17px;
    height: 17px;
  }
  .glyph :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-switch] [data-set-theme]')];
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  for (const m of metas) m.dataset.default = m.content;

  type Choice = 'system' | 'light' | 'dark';

  function stored(): Choice {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(choice: Choice, persist: boolean): void {
    if (choice === 'system') {
      root.removeAttribute('data-theme');
    } else {
      root.setAttribute('data-theme', choice);
    }
    if (persist) {
      try {
        if (choice === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, choice);
      } catch {
        /* storage may be unavailable (private mode); the page still switches */
      }
    }
    // Keep the browser-chrome colour honest: a forced theme pins both theme-color metas to the
    // page's current background; System restores the media-driven values from the HTML.
    const bg = getComputedStyle(root).getPropertyValue('--bg').trim();
    for (const m of metas) m.content = choice === 'system' ? (m.dataset.default ?? m.content) : bg;
    for (const btn of buttons) {
      btn.setAttribute('aria-pressed', String(btn.dataset.setTheme === choice));
    }
  }

  // The head script already set the attribute pre-paint; this syncs the buttons and metas.
  apply(stored(), false);

  for (const btn of buttons) {
    btn.addEventListener('click', () => apply(btn.dataset.setTheme as Choice, true));
  }

  // A choice made in another tab applies here too.
  window.addEventListener('storage', (e) => {
    if (e.key === KEY) apply(stored(), false);
  });
</script>
