---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../config';
import { press, pressFiles } from '../press';

// The English store screens, shown small here; the full-size files are in the zips
// (scripts/build-press-kit.ts). English-only page (`page={null}`), like /blog and /privacy: the
// Arabic and Turkish screenshots are offered as downloads below.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../../../docs/store-screens/en/0[1-7]-*.png',
  { eager: true },
);
const shots = await Promise.all(
  Object.entries(screens)
    .filter(([path]) => !path.includes('-play'))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => ({
      name: path.split('/').pop()!.replace('.png', '').replace(/^\d+-/, ''),
      img: await getImage({ src: mod.default, width: 300, format: 'webp' }),
    })),
);
const alt: Record<string, string> = {
  today: 'Today: the five prayers, the next one and a countdown.',
  watch: 'The Apple Watch app.',
  history: 'History: a calendar of the month.',
  qibla: 'The qibla compass.',
  reminders: 'Reminders for each prayer.',
  qada: 'Prayers to make up, counted down.',
  pledge: 'The promise: no ads, no account, every feature free.',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Simple Prayer press kit',
    url: new URL('/press', Astro.site).href,
    about: { '@type': 'MobileApplication', name: site.name, url: new URL('/', Astro.site).href },
    publisher: { '@id': 'https://majani.plus/#organization' },
  },
];
---

<Base
  title="Press kit — Simple Prayer"
  description="Facts, descriptions, logos and screenshots of Simple Prayer, free to use in articles, reviews and lists about the app."
  path="/press"
  locale="en"
  page={null}
  jsonLd={jsonLd}
>
  <div class="section container press">
    <p class="eyebrow">Press kit</p>
    <h1>Writing about Simple Prayer?</h1>
    <p class="lead">
      Here is everything you need: short and long descriptions, the facts, logos and screenshots in
      three languages. You may use all of it in articles, reviews and lists about the app.
    </p>
    <p class="downloads">
      <a class="btn" href={pressFiles.all.href} download>{pressFiles.all.label}</a>
      <a class="btn btn-quiet" href={pressFiles.factSheet.href} download>{pressFiles.factSheet.label}</a>
    </p>
    <p class="hint">
      Questions, or need something that is not here? Write to <a href={`mailto:${press.contact}`}>{press.contact}</a>.
    </p>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>Describing the app</h2>
    <p class="caption">Copy any of these as they are.</p>
    <div class="card copy">
      <p class="label">In one sentence</p>
      <p>{press.oneLine}</p>
    </div>
    <div class="card copy">
      <p class="label">In a paragraph</p>
      <p>{press.short}</p>
    </div>
    <div class="card copy">
      <p class="label">In more detail</p>
      {press.long.map((para) => <p>{para}</p>)}
    </div>

    <h2>Facts</h2>
    <dl class="facts">
      {press.facts.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))}
    </dl>

    <h2>What stands out</h2>
    <ul class="highlights">
      {press.highlights.map((h) => <li>{h}</li>)}
    </ul>
    <p>
      The <a href="/blog">articles</a> cover the technical side: the fixes sent to adhan-js, prayer
      times above the Arctic Circle, widgets and watches from one Expo app, and the buddy relay.
    </p>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>Screenshots</h2>
    <p>
      The store images with their captions, and the app itself with no captions, in the light and
      dark themes. Full size, one zip for each language:
    </p>
    <p class="downloads">
      {pressFiles.screenshots.map((s) => (
        <a class="btn btn-quiet" href={s.href} download lang={s.lang}>{s.label}</a>
      ))}
    </p>
    <ul class="shots">
      {shots.map((s) => (
        <li>
          <img src={s.img.src} width={s.img.attributes.width} height={s.img.attributes.height} alt={alt[s.name] ?? ''} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>

    <h2>Logo and icon</h2>
    <div class="logo-row">
      <div class="logo-tile logo-paper"><Logo size={64} /></div>
      <div class="logo-tile logo-gold"><Logo size={64} color="#f3e7c8" /></div>
      <div class="logo-tile logo-night"><Logo size={64} color="#f3e7c8" /></div>
    </div>
    <p class="downloads">
      <a class="btn btn-quiet" href={pressFiles.logos.href} download>{pressFiles.logos.label}</a>
      <a class="btn btn-quiet" href={pressFiles.icon.href} download>{pressFiles.icon.label}</a>
    </p>
    <ul>
      <li>Use the files as they are. Please do not redraw, recolour, stretch or add effects to the mark.</li>
      <li>Gold on light backgrounds, cream on dark or gold ones.</li>
      <li>Write the name as two words, <b>Simple Prayer</b>, with capitals on both.</li>
      <li>
        The name and the mosque mark belong to Majani Plus and are not covered by the code's MIT
        licence. You may use them to write about the app (<a href={`${site.sourceUrl}/blob/main/TRADEMARKS.md`} rel="noopener">trademarks</a>).
      </li>
    </ul>

    <div class="ornament" aria-hidden="true"><span>◆</span></div>

    <h2>Easy to get wrong</h2>
    <dl class="facts accuracy">
      {press.accuracy.map(([wrong, right]) => (
        <>
          <dt>Not "{wrong}"</dt>
          <dd>{right}</dd>
        </>
      ))}
    </dl>

    <h2>Links</h2>
    <dl class="facts">
      {press.links.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd><a href={v} rel="noopener">{v.replace(/^https:\/\//, '')}</a></dd>
        </>
      ))}
    </dl>
  </div>
</Base>

<style>
  .press {
    max-width: 820px;
  }
  .lead {
    font-size: 1.12rem;
  }
  h2 {
    margin-top: 2.2rem;
  }
  .downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 1.2rem 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px; /* the app's touch floor (D55) */
    padding: 10px 20px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    color: var(--seal-fg);
    background: var(--accent);
    border: 1px solid var(--accent);
  }
  .btn:hover {
    color: var(--seal-fg);
    background: var(--accent-deep);
  }
  .btn-quiet {
    color: var(--ink);
    background: var(--card);
    border-color: var(--border-mid);
    font-weight: 400;
  }
  .btn-quiet:hover {
    color: var(--ink);
    background: var(--card-bright);
    border-color: var(--border-strong);
  }
  .copy {
    margin-bottom: 12px;
  }
  .copy p:last-child {
    margin-bottom: 0;
  }
  .label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--diamond);
    margin-bottom: 0.4em;
  }
  .facts {
    display: grid;
    grid-template-columns: minmax(150px, 220px) 1fr;
    gap: 0;
    margin: 0;
  }
  .facts dt,
  .facts dd {
    margin: 0;
    padding: 10px 0;
    border-top: 1px solid var(--hairline);
  }
  .facts dt {
    font-weight: 600;
    padding-inline-end: 16px;
  }
  .facts dd a {
    overflow-wrap: anywhere;
  }
  .accuracy dt {
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
  }
  .highlights li {
    margin-bottom: 0.4em;
  }
  .shots {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }
  .shots img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid var(--border-faint);
  }
  .logo-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 1rem 0 0.4rem;
  }
  .logo-tile {
    width: 140px;
    height: 110px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    border: 1px solid var(--border-faint);
  }
  .logo-paper {
    background: var(--card);
  }
  .logo-gold {
    background: #8a6420;
  }
  .logo-night {
    background: #20190e;
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .facts dd {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
